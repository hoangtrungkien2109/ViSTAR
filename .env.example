# Shared ViSTAR services
DELAY_TIME=0.0
BATCH_SIZE=10
DEFAULT_DICT=default
CUTTING_MODEL_PATH=src/ai/model_weights/cut.pth
DEFAULT_CHARACTER_PATH=
VISTAR_SESSION_SECRET=replace-with-a-long-random-value
VISTAR_DATABASE_URL=sqlite:///./users.db
CREATE_DEFAULT_ADMIN=false
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Runtime recognizer selection: baseline | felf_slr
SIGN_RECOGNIZER=felf_slr
RECOGNIZER_DEVICE=auto
RECOGNIZER_SEQUENCE_LENGTH=40
RECOGNIZER_THRESHOLD=0.70

# Optional shared override. Prefer the mode-specific files below.
RECOGNIZER_LABELS_FILE=

# Existing ViSTAR Baseline
BASELINE_CHECKPOINT=src/be/n2_dict.pth
BASELINE_LABELS_FILE=

# Packaged 23-class FELF-SLR deployment.
FELF_LABELS_FILE=src/be/checkpoints/vistar23_labels.json
FELF_CHECKPOINT=src/be/checkpoints/vistar23_felf_seed42_swa.pth
FELF_BASELINE_CHECKPOINT=
FELF_LRG_CHECKPOINT=
FELF_RF_CHECKPOINT=
FELF_LRG_WEIGHT=1.0
FELF_RF_WEIGHT=1.0

# Stage 2 adds the matching 23-class MorphTraj expert.
FELF_REQUIRE_MT=true
FELF_MT_CHECKPOINT=src/be/checkpoints/vistar23_mt_seed42_swa.pth
FELF_MT_FEATURE_VERSION=v1
FELF_MT_BRANCH_DIM=128
FELF_MT_CONDITIONING=none
FELF_STAGE2_BASELINE_WEIGHT=0.5
FELF_STAGE2_FELF_WEIGHT=1.0
FELF_STAGE2_MT_WEIGHT=0.5

# Architecture values must match the FELF checkpoints.
FELF_BRANCH_DIM=96
FELF_NUM_LAYERS=2
FELF_NUM_HEADS=4
FELF_FF_DIM=768
FELF_DROPOUT=0.2
